# Copy outside the checkout (for example /srv/bakeplan/private/deploy.env).
# This file contains no credentials and cannot launch until AUTH_FILE is set.
BAKEPLAN_AUTH_FILE=
BAKEPLAN_RELEASE=local
BAKEPLAN_DB_FILE=bakeplan.sqlite3

# Choose approved immutable registry digests before a hosted release.
# Exact version tags below reproduce the tested major toolchains but tags can move.
PYTHON_IMAGE=python:3.14.8-slim-bookworm
NODE_IMAGE=node:24.19.0-bookworm-slim
CADDY_IMAGE=caddy:2.10.2-alpine

# Used only with compose.https.yaml; intentionally blank, no host chosen.
BAKEPLAN_DOMAIN=
BAKEPLAN_ACME_EMAIL=
