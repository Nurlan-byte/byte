# Local SQLite path; business data must stay outside the public repository.
BAKEPLAN_DB=data/bakeplan.sqlite3
# For a local operator session, set this environment variable before starting the API.
BAKEPLAN_POS_ENABLED=0
# Private encryption key file for saved connections; use backend.pos_vault init once.
BAKEPLAN_POS_MASTER_KEY_FILE=
# Optional weather subscription; evaluation is for non-commercial tests.
BAKEPLAN_WEATHER_MODE=
BAKEPLAN_WEATHER_API_KEY=
